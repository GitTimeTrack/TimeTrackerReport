<Window x:Class="TimeTracker.Windows.TaskCopyWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="作業・予定を複製" Width="640" Height="620" MinWidth="520" MinHeight="460" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{Binding SourceLabel}" FontSize="18" FontWeight="Bold"/><TextBlock Text="追加する作業を選んでください。元の記録は残り、実績は0hで登録します。" TextWrapping="Wrap" Margin="0,8,0,12"/><Button Content="すべて選択 / 解除" Click="SelectAll" HorizontalAlignment="Left" Margin="0,0,0,10"/></StackPanel>
  <ListBox Grid.Row="1" ItemsSource="{Binding Choices}" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="{Binding Task.Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Foreground="{DynamicResource MutedBrush}"><Run Text="{Binding Task.Project}"/><Run Text="　予定 "/><Run Text="{Binding Task.PlannedHours}"/><Run Text="h"/></TextBlock></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox>
  <StackPanel Grid.Row="2" Margin="0,16,0,0"><WrapPanel><TextBlock Text="登録先" VerticalAlignment="Center" Margin="0,0,12,0"/><DatePicker x:Name="DestinationDate" Width="150"/><ComboBox x:Name="DestinationKind" Width="130" Margin="12,0,0,0"><ComboBoxItem Content="作業"/><ComboBoxItem Content="予定"/></ComboBox></WrapPanel><CheckBox x:Name="IncludeNotes" Content="詳細メモも引き継ぐ" IsChecked="True"/><TextBlock x:Name="InputError" TextWrapping="Wrap"/></StackPanel>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="キャンセル" IsCancel="True"/><Button x:Name="SubmitButton" Content="確認して追加" Style="{StaticResource PrimaryButton}" Click="Submit" IsDefault="True"/></StackPanel>
 </Grid>
</Window>
