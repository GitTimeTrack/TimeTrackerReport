<Window x:Class="TimeTracker.Windows.TaskCopyWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="作業・予定を複製" Width="660" Height="640" MinWidth="540" MinHeight="480" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock x:Name="SourceHeading" Text="{Binding SourceLabel}" FontSize="18" FontWeight="Bold"/>
   <TextBlock Text="追加する作業を選んでください。元の記録は残り、実績は0hで登録します。" TextWrapping="Wrap" Margin="0,6,0,10"/>
   <WrapPanel x:Name="SourceBar" Margin="0,0,0,8" Visibility="Collapsed">
    <TextBlock Text="複製元" VerticalAlignment="Center" Margin="0,0,10,6" Foreground="{DynamicResource MutedBrush}"/>
    <Button x:Name="SourceTodayButton" Content="本日の予定" Tag="Today" Click="ChangeSource" Padding="10,5" Margin="0,0,6,6"/>
    <Button x:Name="SourcePreviousButton" Content="前日の作業" Tag="Previous" Click="ChangeSource" Padding="10,5" Margin="0,0,6,6"/>
    <Button x:Name="SourceNextButton" Content="次日の予定" Tag="Next" Click="ChangeSource" Padding="10,5" Margin="0,0,6,6"/>
   </WrapPanel>
   <DockPanel Margin="0,0,0,10">
    <Button Content="すべて選択 / 解除" Click="SelectAll" HorizontalAlignment="Left" Margin="0"/>
    <TextBlock x:Name="EmptySourceHint" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
   </DockPanel>
  </StackPanel>
  <ListBox Grid.Row="1" ItemsSource="{Binding Choices}" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="{Binding Task.Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Foreground="{DynamicResource MutedBrush}"><Run Text="{Binding Task.Project}"/><Run Text="　予定 "/><Run Text="{Binding Task.PlannedHours, StringFormat={}{0:0.0}}"/><Run Text="h"/></TextBlock></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox>
  <StackPanel Grid.Row="2" Margin="0,16,0,0">
   <WrapPanel>
    <TextBlock Text="登録先" VerticalAlignment="Center" Margin="0,0,12,6"/>
    <DatePicker x:Name="DestinationDate" Width="150" SelectedDateChanged="DestinationChanged" VerticalAlignment="Center" Margin="0,0,10,6"/>
    <Button x:Name="TargetTodayButton" Content="本日の予定へ" Click="SelectTargetToday" Padding="10,5" Margin="0,0,6,6" VerticalAlignment="Center"/>
    <Button x:Name="TargetNextButton" Content="次日の予定へ" Click="SelectTargetNext" Padding="10,5" Margin="0,0,10,6" VerticalAlignment="Center"/>
    <TextBlock x:Name="DestinationBadge" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,6"/>
   </WrapPanel>
   <CheckBox x:Name="IncludeNotes" Content="詳細メモも引き継ぐ" IsChecked="True"/>
   <TextBlock x:Name="InputError" TextWrapping="Wrap"/>
  </StackPanel>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="キャンセル" IsCancel="True"/><Button x:Name="SubmitButton" Content="確認して追加" Style="{StaticResource PrimaryButton}" Click="Submit" IsDefault="True"/></StackPanel>
 </Grid>
</Window>
