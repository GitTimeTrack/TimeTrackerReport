<Window x:Class="TimeTracker.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:TimeTracker.Windows"
 Icon="Assets/app.ico" Title="TimeTrackerReport" Width="1240" Height="840" MinWidth="920" MinHeight="660"
 Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
 <Window.Resources>
  <local:ViewSelectionConverter x:Key="ViewSelection"/>
  <Style x:Key="ScheduleTab" TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
   <Setter Property="Padding" Value="18,12"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="ScheduleTabFrame" CornerRadius="10,10,0,0" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1,1,1,0">
     <Grid><ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
      <Border x:Name="SelectedMark" Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="12,0" Visibility="Collapsed"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter TargetName="ScheduleTabFrame" Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Panel.ZIndex" Value="10"/><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/><Setter Property="AutomationProperties.ItemStatus" Value="選択中"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="ScheduleTabFrame" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></MultiTrigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ScheduleTabFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="InlineTimeButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style x:Key="TaskList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
   <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
   <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
   <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
   <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
   <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
   <Setter Property="AllowDrop" Value="True"/>
   <EventSetter Event="PreviewDragOver" Handler="TaskDragOver"/>
   <EventSetter Event="Drop" Handler="TaskDrop"/>
   <EventSetter Event="DragLeave" Handler="TaskDragLeave"/>
   <EventSetter Event="PreviewKeyDown" Handler="TaskListKeyDown"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="RowFrame" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><ContentPresenter/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowFrame" Property="Background" Value="{DynamicResource CanvasBrush}"/></Trigger>
      <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter TargetName="RowFrame" Property="Background" Value="{DynamicResource RunningSurfaceBrush}"/></DataTrigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="RowFrame" Property="BorderThickness" Value="3,0,0,1"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="TaskCard">
   <Grid Margin="8,0">
    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
    <Border Background="Transparent" Cursor="SizeAll" ToolTip="ドラッグして並べ替え（Alt + ↑ / ↓ でも移動）" PreviewMouseLeftButtonDown="DragHandleDown" PreviewMouseMove="DragHandleMove">
     <TextBlock Text="⠿" FontSize="22" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,16,0" ToolTip="{Binding Notes}">
     <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
     <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Project}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Project}"/>
      <TextBlock x:Name="RunningBadge" Grid.Column="1" Text="● 計測中" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" Visibility="Collapsed"/>
     </Grid>
    </StackPanel>
    <Button Grid.Column="2" Content="{Binding PlannedValue}" Tag="{Binding}" Click="BeginInlineEdit" ToolTip="予定時間を一覧で編集" Style="{StaticResource InlineTimeButton}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" Padding="4,5"/>
    <Button Grid.Column="3" Content="{Binding ActualValue}" Tag="{Binding}" CommandParameter="Actual" Click="BeginInlineEdit" IsEnabled="{Binding CanEditActual}" ToolTip="実績時間を一覧で編集" Style="{StaticResource InlineTimeButton}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0" Padding="4,5"/>
    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
     <Button Content="{Binding ActionLabel}" Tag="{Binding}" Click="ToggleTask" Style="{StaticResource RowButton}" MinWidth="72"/>
     <Button Content="編集" Tag="{Binding}" Click="EditTask" Style="{StaticResource RowButton}"/>
     <Button Content="削除" Tag="{Binding}" Click="DeleteTask" Style="{StaticResource RowButton}"/>
    </StackPanel>
    <Expander Grid.Row="1" Grid.ColumnSpan="5" Header="詳細メモ" IsExpanded="{Binding IsNotesExpanded, Mode=TwoWay}" Margin="34,0,10,8" Foreground="{DynamicResource TextBrush}">
     <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasNotes}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style>
     <StackPanel><TextBox Text="{Binding Notes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="{DynamicResource CanvasBrush}" Margin="0,8,0,0" Padding="12" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="詳細メモ"/><Button Content="メモを一覧で編集" Tag="{Binding}" CommandParameter="Notes" Click="BeginInlineEdit" HorizontalAlignment="Left" Margin="0,6,0,0" Style="{StaticResource RowButton}"/></StackPanel>
    </Expander>
    <Border Grid.Row="2" Grid.ColumnSpan="5" Margin="34,4,10,12" Padding="14" Background="{DynamicResource CanvasBrush}" CornerRadius="8">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsInlineEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <StackPanel><WrapPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="予定時間（h）"/><TextBox x:Name="DraftPlanned" Text="{Binding Draft.PlannedText, UpdateSourceTrigger=PropertyChanged}" Width="100" KeyDown="InlineKeyDown" AutomationProperties.Name="一覧の予定時間"/></StackPanel><StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsPlan}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="実績時間（h）"/><TextBox x:Name="DraftActual" Text="{Binding Draft.ActualText, UpdateSourceTrigger=PropertyChanged}" Width="100" KeyDown="InlineKeyDown" AutomationProperties.Name="一覧の実績時間"/></StackPanel></WrapPanel>
      <TextBlock Text="詳細メモ"/><TextBox x:Name="DraftNotes" Text="{Binding Draft.Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" KeyDown="InlineKeyDown" AutomationProperties.Name="一覧の詳細メモ"/>
      <TextBlock Text="{Binding InlineError}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button Content="保存" Click="SaveInline" Style="{StaticResource PrimaryButton}"/><Button Content="取り消す" Click="CancelInline"/></StackPanel>
     </StackPanel>
    </Border>
   </Grid>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter TargetName="RunningBadge" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SidebarBrush}" Padding="14,24,10,20">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <Image x:Name="BrandIcon" Source="{StaticResource AppClock}" Width="48" Height="48" HorizontalAlignment="Left" AutomationProperties.Name="TimeTrackerReport 時計アイコン"/>
     <TextBlock x:Name="BrandName" Text="TimeTrackerReport" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource OnDarkBrush}" Margin="0,12,0,24"/>
     <Button Style="{StaticResource NavigationButton}" Selector.IsSelected="{Binding SelectedIndex, ElementName=Views, Converter={StaticResource ViewSelection}, ConverterParameter=0}" x:Name="Nav0" Content="◉　ワークスペース" Tag="0" Click="Navigate" Margin="0,0,0,10" Padding="10,14"/>
     <Button Style="{StaticResource NavigationButton}" Selector.IsSelected="{Binding SelectedIndex, ElementName=Views, Converter={StaticResource ViewSelection}, ConverterParameter=1}" x:Name="Nav1" Content="▤　日報をつくる" Tag="1" Click="Navigate" Margin="0,0,0,10" Padding="10,14"/>
     <Button Style="{StaticResource NavigationButton}" Selector.IsSelected="{Binding SelectedIndex, ElementName=Views, Converter={StaticResource ViewSelection}, ConverterParameter=2}" x:Name="Nav2" Content="▥　時間を振り返る" Tag="2" Click="Navigate" Margin="0,0,0,10" Padding="10,14"/>
     <Button Style="{StaticResource NavigationButton}" Selector.IsSelected="{Binding SelectedIndex, ElementName=Views, Converter={StaticResource ViewSelection}, ConverterParameter=3}" x:Name="Nav3" Content="⚙　設定とデータ" Tag="3" Click="Navigate" Margin="0,0,0,10" Padding="10,14"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Bottom">
     <Button Style="{StaticResource SidebarButton}" Content="ミニタイマー" Click="OpenMini" Margin="0,0,0,10"/>
     <Button Style="{StaticResource SidebarButton}" Content="トレイにしまう" Click="HideToTray" Margin="0"/>
     <TextBlock Text="Ctrl + Alt + T：開始 / 停止&#10;Ctrl + Alt + Space：表示" Foreground="{DynamicResource OnDarkMutedBrush}" FontSize="10" Margin="0,18,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="24,20,24,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="ワークスペース" FontSize="23" FontWeight="Bold"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="今日" Click="GoToday"/><DatePicker x:Name="DayPicker" SelectedDateChanged="DateChanged" Width="135" VerticalAlignment="Center"/></StackPanel>
   </Grid>
   <Border Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource HeroBrush}" BorderThickness="0" Margin="0,0,0,16" Padding="20,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding TimerCaption}" Foreground="{DynamicResource OnDarkMutedBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding ActiveName}" Foreground="{DynamicResource OnDarkBrush}" FontSize="19" TextTrimming="CharacterEllipsis" Margin="0,6,18,0"/></StackPanel>
     <TextBlock Grid.Column="1" Text="{Binding ClockText}" Foreground="{DynamicResource OnDarkBrush}" FontFamily="Consolas" FontSize="30" VerticalAlignment="Center" Margin="0,0,22,0"/>
     <Button Grid.Column="2" Content="{Binding ToggleLabel}" Click="GlobalToggle" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" MinWidth="100"/>
    </Grid>
   </Border>
   <TabControl x:Name="Views" SelectedIndex="0" Grid.Row="2" Background="Transparent" BorderThickness="0">
    <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
    <TabItem Header="今日">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12">
       <Button x:Name="TemplateButton" Content="ひな型を読み込む" Click="ImportTemplate" DockPanel.Dock="Right" Margin="12,0,0,0"/>
       <WrapPanel><Button Content="前日の作業から追加" Tag="Previous" Click="CopyTasks"/><Button Content="一覧から複製…" Click="CopyTasks"/></WrapPanel>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="検索" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource MutedBrush}"/>
       <TextBox Grid.Column="1" x:Name="SearchBox" TextChanged="SearchChanged" Margin="0" ToolTip="プロジェクト名・タスク名・メモで検索" AutomationProperties.Name="タスクを検索"/>
      </Grid>
      <TabControl x:Name="ScheduleTabs" SelectionChanged="ScheduleChanged" SelectedIndex="0" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" Padding="12">
       <TabControl.Template><ControlTemplate TargetType="TabControl">
        <Grid KeyboardNavigation.TabNavigation="Local"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <TabPanel x:Name="ScheduleHeaders" IsItemsHost="True" KeyboardNavigation.TabIndex="1" Panel.ZIndex="1" Margin="12,0,0,-1"/>
         <Border x:Name="ScheduleFrame" Grid.Row="1" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
         </Border>
        </Grid>
       </ControlTemplate></TabControl.Template>
       <TabItem x:Name="TodayScheduleTab" Style="{StaticResource ScheduleTab}" AutomationProperties.Name="本日の予定">
        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding TodayTabLabel}"/></StackPanel></TabItem.Header>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <DockPanel Margin="0,4,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="予定を引き継ぐ" Click="CarryPlans"/><Button Content="＋ タスク追加" Click="AddToday" Style="{StaticResource PrimaryButton}" Margin="0"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding TodayDateLabel}" FontWeight="SemiBold"/><TextBlock x:Name="TodayTotals" Text="{Binding TodayTotalsLabel}" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel></DockPanel>
         <Grid Grid.Row="1" Margin="8,0,25,0" Height="30"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Text="タスク / プロジェクト" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="6,0,0,0"/><TextBlock Grid.Column="2" Text="予定" HorizontalAlignment="Right" Margin="0,0,16,0" FontSize="12"/><TextBlock Grid.Column="3" Text="実績" HorizontalAlignment="Right" Margin="0,0,16,0" FontSize="12"/>
         </Grid>
         <Grid Grid.Row="2"><ListBox x:Name="TodayList" ItemsSource="{Binding TodayTasks}" ItemTemplate="{StaticResource TaskCard}" Style="{StaticResource TaskList}" SelectionChanged="TaskSelected"/>
          <TextBlock Text="予定がありません。追加またはひな型読み込みで登録できます。" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TodayTasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
         </Grid>
        </Grid>
       </TabItem>
       <TabItem x:Name="NextScheduleTab" Style="{StaticResource ScheduleTab}" AutomationProperties.Name="次日の予定">
        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding NextTabLabel}"/></StackPanel></TabItem.Header>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <DockPanel Margin="0,4,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="＋ 予定追加" Click="AddNext" Style="{StaticResource PrimaryButton}" Margin="0"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding NextDateLabel}" FontWeight="SemiBold"/><TextBlock x:Name="NextTotals" Text="{Binding NextTotalsLabel}" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel></DockPanel>
         <Grid Grid.Row="1" Margin="8,0,25,0" Height="30"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Text="タスク / プロジェクト" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="6,0,0,0"/><TextBlock Grid.Column="2" Text="予定" HorizontalAlignment="Right" Margin="0,0,16,0" FontSize="12"/><TextBlock Grid.Column="3" Text="実績" HorizontalAlignment="Right" Margin="0,0,16,0" FontSize="12"/>
         </Grid>
         <Grid Grid.Row="2"><ListBox x:Name="NextList" ItemsSource="{Binding NextTasks}" ItemTemplate="{StaticResource TaskCard}" Style="{StaticResource TaskList}" />
          <TextBlock Text="予定がありません。追加またはひな型読み込みで登録できます。" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NextTasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
         </Grid>
        </Grid>
       </TabItem>
      </TabControl>
      <TextBlock Grid.Row="3" Text="⠿ をドラッグ / Alt + ↑ ↓ で並べ替え（検索中は検索をクリアしてください）" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
     </Grid>
    </TabItem>
    <TabItem Header="日報"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,16" LastChildFill="False"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="コピー" Click="CopyReport" Style="{StaticResource PrimaryButton}"/><Button Content="TXT出力" Click="ExportReport"/><Button Content="CSV出力" Click="ExportCsv"/></StackPanel></DockPanel>
     <TextBox Grid.Row="1" Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Yu Gothic UI" Padding="20"/>
    </Grid></TabItem>
    <TabItem Header="分析"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16"><ComboBox x:Name="PeriodBox" Width="110" SelectedIndex="0" SelectionChanged="PeriodChanged"><ComboBoxItem Content="日単位"/><ComboBoxItem Content="週単位"/><ComboBoxItem Content="月単位"/></ComboBox><TextBlock Text="{Binding PeriodLabel}" Margin="18,0" VerticalAlignment="Center"/><Button Content="CSV出力" Click="ExportAnalytics"/></StackPanel>
     <ListBox Grid.Row="2" ItemsSource="{Binding Summaries}"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Project}" FontWeight="SemiBold" FontSize="17"/><TextBlock Margin="0,8,0,10"><Run Text="予定 "/><Run Text="{Binding PlannedHours, StringFormat={}{0:0.0}}"/><Run Text="h　 /　 実績 "/><Run Text="{Binding ActualHours, StringFormat={}{0:0.0}}"/><Run Text="h"/></TextBlock><ProgressBar Height="6" Maximum="{Binding Scale}" Value="{Binding ActualHours}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid></TabItem>
    <TabItem Header="設定"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="外観" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="カラーテーマ" Margin="0,16,0,8"/>
      <ListBox x:Name="PaletteBox" SelectionChanged="ThemeSelectionChanged" SelectedValuePath="Id" AutomationProperties.Name="カラーテーマ">
       <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Choice" Padding="10" BorderThickness="2" CornerRadius="8" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource SurfaceBrush}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Choice" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="FontWeight" Value="Bold"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Choice" Property="BorderThickness" Value="3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Border Width="32" Height="16" Background="{Binding Sidebar}" CornerRadius="3"/><Border Width="32" Height="16" Background="{Binding Primary}" CornerRadius="3" Margin="6,0"/><Border Width="32" Height="16" Background="{Binding Soft}" CornerRadius="3"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="ThemePreviewStatus" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"/>
      <Button Content="配色の変更を取り消す" Click="DiscardTheme" HorizontalAlignment="Left" Margin="0,8,0,4"/>
      <DockPanel Margin="0,10,0,14"><TextBlock Text="明暗" VerticalAlignment="Center"/><ComboBox x:Name="ThemeBox" SelectionChanged="ThemeSelectionChanged" Width="160" Margin="20,0,0,0" SelectedIndex="0"><ComboBoxItem Content="Windowsに合わせる"/><ComboBoxItem Content="ライト"/><ComboBoxItem Content="ダーク"/></ComboBox></DockPanel>
<Button Content="設定を保存" Click="SaveSettings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="計測と通知" FontSize="17" FontWeight="SemiBold"/>
      <CheckBox x:Name="PlannedOverrunAlert" Content="予定時間を超えたら通知と音で知らせる"/>
      <CheckBox x:Name="LongAlert" Content="長時間の計測を通知する"/><DockPanel><TextBlock Text="通知までの時間（15〜360分）" VerticalAlignment="Center"/><TextBox x:Name="LongMinutes" Width="80" Margin="15,4,0,4"/></DockPanel>
      <CheckBox x:Name="IdleAlert" Content="計測していない時間が続いたら通知する"/><DockPanel><TextBlock Text="未計測・離席の判定（5〜120分）" VerticalAlignment="Center"/><TextBox x:Name="IdleMinutes" Width="80" Margin="15,4,0,4"/></DockPanel>
      <CheckBox x:Name="PauseIdle" Content="離席を検知したら一時停止し、復帰時に時間の扱いを確認する"/>
      <CheckBox x:Name="PauseLock" Content="画面ロック時に一時停止する（スリープ時は常に停止）"/>
      <CheckBox x:Name="CloseTray" Content="閉じるボタンで終了せず、トレイに常駐する"/>
      <CheckBox x:Name="Startup" Content="Windowsサインイン時にトレイで起動する"/>
      <Button Content="設定を保存" Click="SaveSettings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="使い方" FontSize="17" FontWeight="SemiBold"/><Button Content="導入ガイドをもう一度表示" Click="ReplayGuide" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="バージョン情報" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" Text="{Binding VersionLabel}" Margin="0,10,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="データとバックアップ" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding DataPath}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,15"/>
      <WrapPanel><Button Content="JSONバックアップ" Click="ExportBackup" Margin="0,0,8,8"/><Button Content="JSONを移行・復元" Click="ImportBackup" Margin="0,0,8,8"/><Button Content="保存先を開く" Click="OpenDataFolder" Margin="0,0,8,8"/><Button Content="ひな型を読み込む" Click="ImportTemplate" Margin="0,0,8,8"/></WrapPanel>
      <TextBlock Text="旧Web版のバックアップJSONも読み込めます。復元前に現在のデータを自動バックアップします。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <StackPanel Grid.Row="3">
    <Border x:Name="UndoNotice" Padding="12,8" Margin="0,8,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanUndo}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding UndoLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding UndoLabel}"/><TextBlock Text="復元できるのは直近1件です。次の削除で対象が置き換わります。" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,8,0"/></StackPanel>
      <Button x:Name="UndoButton" Grid.Column="1" Content="元に戻す" Click="UndoDelete" IsEnabled="{Binding CanUndo}" VerticalAlignment="Center" Margin="12,0,0,0"/>
     </Grid>
    </Border>
    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel>
  </Grid>
  <Border x:Name="GuideBanner" Grid.Column="1" VerticalAlignment="Top" Margin="24,8,24,0" Padding="12,8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Panel.ZIndex="100">
   <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding GuideVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding GuideText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="閉じても、設定からいつでも再表示できます。" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
    <Button Grid.Column="1" Content="{Binding GuideActionText}" Click="GuideAction" Padding="8,6" Margin="8,0" VerticalAlignment="Center"/><Button Grid.Column="2" Content="×" Click="CloseGuide" Padding="7,4" Margin="0" VerticalAlignment="Top" AutomationProperties.Name="導入ガイドを閉じる"/>
   </Grid>
  </Border>
 </Grid>
</Window>
